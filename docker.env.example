# Copy to ".env" in this directory (Compose loads it automatically for variable substitution):
#   cp docker.env.example .env
#
# RAILS_MASTER_KEY must match config/master.key (one line, no spaces or quotes).

RAILS_MASTER_KEY=

# If host port 3000 is already taken (another container, bin/rails server, etc.):
# HOST_PORT=3001
